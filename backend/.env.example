# Copia este archivo como .env y completa los valores reales.
# En produccion (Railway) estas variables se definen en el panel del servicio.

NODE_ENV=development
PORT=3000

# PostgreSQL local. En produccion, Railway inyecta esta variable solo:
# en el servicio del backend se referencia como ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/santiago_dev?schema=public"

# Origenes permitidos para CORS, separados por coma.
# En produccion: https://tu-dominio.vercel.app
CORS_ORIGIN=http://localhost:4200

# Secreto para firmar los JWT del panel admin. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# Sal para anonimizar las IP al deduplicar calificaciones de la comunidad.
# Genera una distinta al JWT_SECRET con el mismo comando de arriba.
RATING_SALT=cambia-esto-por-otra-cadena-aleatoria

# Debe ser true en produccion (HTTPS) y false en local (HTTP).
COOKIE_SECURE=false

# Credenciales iniciales del admin, usadas solo por `npm run db:seed`.
# Usa una contrasena larga: el panel queda expuesto en internet.
ADMIN_USERNAME=santiago
ADMIN_INITIAL_PASSWORD=cambiar-esta-clave
